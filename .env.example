# Environment variables — copy this to .env and fill in values
# Never commit the actual .env file

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/arxion_dev"

# API
PORT=3001
NODE_ENV=development

# Internal service key used by MCP server to authenticate with API
INTERNAL_API_KEY="change-this-to-a-random-secret"

# GitHub integration (optional for public repositories; required for private repositories)
GITHUB_TOKEN="github-token-with-repository-read-access"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXT_PUBLIC_IDE_BRIDGE_URL="http://127.0.0.1:3210"

# MCP Server
MCP_API_BASE_URL="http://localhost:3001"
MCP_API_KEY="change-this-to-a-random-secret"

# Local IDE bridge (binds to 127.0.0.1 only)
ARXION_API_URL="http://127.0.0.1:3001"
ARXION_BRIDGE_PORT=3210
ARXION_WEB_ORIGIN="http://localhost:3000"
# Optional override. Defaults to the repository containing apps/ide-bridge.
# ARXION_WORKSPACE_ROOT="C:\\path\\to\\arxion"
