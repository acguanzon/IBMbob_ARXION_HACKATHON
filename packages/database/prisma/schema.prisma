// Prisma schema for Arxion — Agent-agnostic collaboration platform
// Phase 4: Git-Verified Change Intelligence and Cross-Agent Impact Propagation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  VIEWER
}

enum FileReservationStatus {
  ACTIVE
  RELEASED
  CONFLICT
  EXPIRED
}

enum AgentType {
  IBM_BOB
  CODEX
  CURSOR
  CLAUDE_CODE
  OTHER
}

enum AgentSessionStatus {
  IDLE
  WORKING
  WAITING
  FINISHED
  STALE
}

// Phase 3: Expanded review status
enum ReviewStatus {
  PENDING
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  INVALIDATED
  REJECTED
  SUPERSEDED
}

enum ContractType {
  API
  MODEL
  SCHEMA
  TYPE
  EVENT
  OTHER
}

enum ContractRelationship {
  PROVIDES
  MODIFIES
  CONSUMES
}

// Phase 3: Contract lifecycle status
enum ContractVersionStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  SUPERSEDED
}

// Phase 3: Review finding source
enum ReviewFindingSource {
  AI
  HUMAN
  SYSTEM
}

// Phase 3: Review finding category
enum ReviewFindingCategory {
  GENERAL
  FILE
  CONTRACT
  TEST
  ARCHITECTURE
  SECURITY
  DEPENDENCY
  SCOPE
}

// Phase 3: Review finding severity
enum ReviewFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Phase 3: Review finding resolution status
enum ReviewFindingStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Phase 3: Merge status
enum MergeStatus {
  NOT_STARTED
  READY
  MERGED
  FAILED
  CANCELLED
}

// Phase 4: Git provider type
enum GitProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

// Phase 4: Repository connection status
enum RepositoryStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

// Phase 4: External event processing status
enum ExternalEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

// Phase 4: Actual change type from git diff
enum ActualChangeType {
  ADDED
  MODIFIED
  DELETED
  RENAMED
}

// Phase 4: Code entity type
enum CodeEntityType {
  FILE
  API
  TYPE
  MODEL
  SCHEMA
  EVENT
  MODULE
}

// Phase 4: Code relationship kind
enum CodeRelationshipKind {
  PROVIDES
  CONSUMES
  IMPORTS
  DEPENDS_ON
  IMPLEMENTS
  MODIFIES
  DEFINES
  CALLS
}

// Phase 4: Relationship detection source
enum RelationshipSource {
  DETERMINISTIC
  DECLARED
  INFERRED
}

// Phase 4: Confidence level
enum Confidence {
  HIGH
  MEDIUM
  LOW
}

// Phase 4: Contract change kind
enum ContractChangeKind {
  ADDED
  REMOVED
  MODIFIED
  RENAMED
}

// Phase 4: Coordination risk type
enum CoordinationRiskType {
  FILE_OVERLAP
  CONTRACT_CHANGE
  DEPENDENCY_CHANGE
  SCOPE_EXPANSION
  SCHEMA_CHANGE
  STALE_REVIEW
  BRANCH_DIVERGENCE
  MERGE_CONFLICT
  ARCHITECTURAL_CONFLICT
}

// Phase 4: Coordination risk severity
enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Phase 4: Coordination risk status
enum CoordinationRiskStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

// Phase 4: Context update status
enum ContextUpdateStatus {
  UNREAD
  READ
  ACKNOWLEDGED
  RESOLVED
}

// Phase 3: Project decision status
enum ProjectDecisionStatus {
  ACTIVE
  SUPERSEDED
  DEPRECATED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectMemberships  ProjectMember[]
  createdProjects     Project[]              @relation("CreatedByUser")
  assignedTasks       Task[]                 @relation("AssignedTasks")
  createdTasks        Task[]                 @relation("CreatedTasks")
  fileReservations    TaskFileReservation[]
  agentSessions       AgentSession[]
  taskActivities      TaskActivity[]
  reviews             Review[]
  approvedReviews     Review[]               @relation("ApprovedReviews")
  reviewFindings      ReviewFinding[]
  projectDecisions    ProjectDecision[]      @relation("CreatedDecisions")
  userSessions        UserSession[]
  launchRequests      AgentLaunchRequest[]

  @@map("users")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?
  repositoryUrl String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy           User                  @relation("CreatedByUser", fields: [createdById], references: [id])
  members             ProjectMember[]
  tasks               Task[]
  fileReservations    TaskFileReservation[]
  agentSessions       AgentSession[]
  taskActivities      TaskActivity[]
  taskContracts       TaskContract[]
  projectDecisions    ProjectDecision[]
  // Phase 4
  repositories        ProjectRepository[]
  codeEntities        CodeEntity[]
  codeRelationships   CodeRelationship[]
  taskCodeEntities    TaskCodeEntity[]
  coordinationRisks   CoordinationRisk[]
  contextUpdates      ContextUpdate[]
  // Phase 5
  handoffs            TaskHandoff[]
  parallelSafetyEvals ParallelSafetyEvaluation[]
  agentCapabilities   AgentIntegrationCapability[]
  // Realignment
  launchRequests      AgentLaunchRequest[]

  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id                 String       @id @default(cuid())
  projectId          String
  displayId          String
  title              String
  description        String?
  status             TaskStatus   @default(BACKLOG)
  priority           TaskPriority @default(MEDIUM)
  assigneeId         String?
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  acceptanceCriteria String[]

  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee          User?                  @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy         User                   @relation("CreatedTasks", fields: [createdById], references: [id])
  dependencies      TaskDependency[]       @relation("TaskDependencies")
  dependents        TaskDependency[]       @relation("DependentTasks")
  fileReservations  TaskFileReservation[]
  agentSessions     AgentSession[]
  taskActivities    TaskActivity[]
  reviews           Review[]
  contracts         TaskContract[]
  workIntents       TaskWorkIntent[]
  completionReports TaskCompletionReport[]
  gitLinks          TaskGitLink[]
  contractVersions  ContractVersion[]
  projectDecisions  ProjectDecision[]      @relation("TaskDecisions")
  // Phase 4
  actualChanges     TaskActualChange[]
  contractChanges   ContractChange[]
  sourceRisks       CoordinationRisk[]     @relation("SourceRisks")
  affectedRisks     CoordinationRisk[]     @relation("AffectedRisks")
  sourceUpdates     ContextUpdate[]        @relation("SourceUpdates")
  affectedUpdates   ContextUpdate[]        @relation("AffectedUpdates")
  // Phase 5
  readinessEvals    TaskReadinessEvaluation[]
  sourceHandoffs    TaskHandoff[]          @relation("HandoffSource")
  targetHandoffs    TaskHandoff[]          @relation("HandoffTarget")
  contextPackages   TaskContextPackage[]
  recoverySnapshots RecoverySnapshot[]
  parallelSafetyA   ParallelSafetyEvaluation[] @relation("ParallelSafetyA")
  parallelSafetyB   ParallelSafetyEvaluation[] @relation("ParallelSafetyB")
  launchRequests    AgentLaunchRequest[]
  codeEntities      TaskCodeEntity[]

  @@unique([projectId, displayId])
  @@map("tasks")
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task      Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependentTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskFileReservation {
  id              String                @id @default(cuid())
  projectId       String
  taskId          String
  userId          String
  agentSessionId  String?
  filePath        String                // normalized path
  status          FileReservationStatus @default(ACTIVE)
  reservedAt      DateTime              @default(now())
  leaseExpiresAt  DateTime?             // null = no expiry; set when agent session starts
  releasedAt      DateTime?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  agentSession AgentSession? @relation(fields: [agentSessionId], references: [id])

  @@map("task_file_reservations")
}

model AgentSession {
  id              String             @id @default(cuid())
  projectId       String
  userId          String
  taskId          String?
  agentType       AgentType          @default(IBM_BOB)
  externalAgentId String?
  status          AgentSessionStatus @default(IDLE)
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  lastSeenAt      DateTime           @default(now())

  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id])
  task                Task?                 @relation(fields: [taskId], references: [id])
  fileReservations    TaskFileReservation[]
  taskActivities      TaskActivity[]
  completionReports   TaskCompletionReport[]

  @@map("agent_sessions")
}

model TaskActivity {
  id             String   @id @default(cuid())
  projectId      String
  taskId         String?
  userId         String?
  agentSessionId String?
  type           String
  message        String
  metadata       Json?
  createdAt      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  agentSession AgentSession? @relation(fields: [agentSessionId], references: [id])

  @@map("task_activities")
}

/// Phase 3: Full review with lifecycle state machine
model Review {
  id                 String       @id @default(cuid())
  taskId             String
  requestedById      String
  status             ReviewStatus @default(PENDING)
  reviewVersion      Int          @default(1)
  reviewRevision     String?      // git commit SHA at time of review
  comment            String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  approvedAt         DateTime?
  approvedById       String?
  invalidatedAt      DateTime?
  invalidationReason String?

  task          Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy   User            @relation(fields: [requestedById], references: [id])
  approvedBy    User?           @relation("ApprovedReviews", fields: [approvedById], references: [id])
  snapshot      ReviewSnapshot?
  findings      ReviewFinding[]

  @@map("reviews")
}

/// Phase 3: Immutable snapshot of work at the time review was requested
model ReviewSnapshot {
  id                      String   @id @default(cuid())
  reviewId                String   @unique
  taskId                  String
  workRevision            String   // git commit SHA
  gitCommitSha            String?
  branchName              String?
  completionReportId      String?
  declaredIntentSnapshot  Json?    // copy of TaskWorkIntent at review time
  contractSnapshot        Json?    // copy of declared contracts at review time
  fileSnapshot            Json?    // list of files changed
  testSnapshot            Json?    // test results
  createdAt               DateTime @default(now())

  review           Review                @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  completionReport TaskCompletionReport? @relation(fields: [completionReportId], references: [id])

  @@map("review_snapshots")
}

/// Phase 3: Agent-submitted evidence before requesting review
model TaskCompletionReport {
  id              String   @id @default(cuid())
  taskId          String
  agentSessionId  String?
  summary         String
  filesChanged    String[]
  contractsChanged String[]
  testsRun        Int      @default(0)
  testsPassed     Int      @default(0)
  testsFailed     Int      @default(0)
  knownIssues     String?
  scopeChanges    String?
  workRevision    String   // git commit SHA or manual revision identifier
  createdAt       DateTime @default(now())

  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentSession AgentSession?  @relation(fields: [agentSessionId], references: [id])
  snapshots    ReviewSnapshot[]

  @@map("task_completion_reports")
}

/// Phase 3: Structured finding from AI, human, or system
model ReviewFinding {
  id            String                @id @default(cuid())
  reviewId      String
  source        ReviewFindingSource
  category      ReviewFindingCategory @default(GENERAL)
  severity      ReviewFindingSeverity @default(MEDIUM)
  title         String
  description   String
  filePath      String?
  contractName  String?
  status        ReviewFindingStatus   @default(OPEN)
  isBlocking    Boolean               @default(false)
  createdById   String?
  createdAt     DateTime              @default(now())
  resolvedAt    DateTime?

  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@map("review_findings")
}

/// Phase 3 / Phase 4: Git revision binding for a task
model TaskGitLink {
  id                String      @id @default(cuid())
  taskId            String
  repositoryId      String?     // Phase 4: FK to ProjectRepository
  repositoryUrl     String?
  branchName        String?
  baseBranch        String?
  latestCommitSha   String?
  pullRequestUrl    String?
  pullRequestNumber Int?
  mergeStatus       MergeStatus @default(NOT_STARTED)
  mergedCommitSha   String?
  mergedAt          DateTime?
  // Phase 4: divergence tracking
  aheadCount        Int?
  behindCount       Int?
  divergenceCheckedAt DateTime?
  updatedAt         DateTime    @updatedAt

  task       Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repository ProjectRepository? @relation(fields: [repositoryId], references: [id])

  @@map("task_git_links")
}

/// Phase 3: Contract version lifecycle
model ContractVersion {
  id          String                @id @default(cuid())
  contractId  String                // references TaskContract.id
  taskId      String
  version     Int
  status      ContractVersionStatus @default(DRAFT)
  schema      Json?
  metadata    Json?
  createdAt   DateTime              @default(now())
  activatedAt DateTime?

  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contract TaskContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_versions")
}

/// Phase 3: Project decision log
model ProjectDecision {
  id              String                @id @default(cuid())
  projectId       String
  taskId          String?
  title           String
  decision        String
  reason          String?
  createdById     String
  agentSessionId  String?
  status          ProjectDecisionStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  supersededById  String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?   @relation("TaskDecisions", fields: [taskId], references: [id])
  createdBy User    @relation("CreatedDecisions", fields: [createdById], references: [id])

  @@map("project_decisions")
}

// ─── Phase 2 New Models ────────────────────────────────────────────────────────

/// A contract that a task PROVIDES, MODIFIES, or CONSUMES.
/// Used for cross-task integration risk detection.
model TaskContract {
  id           String               @id @default(cuid())
  projectId    String
  taskId       String
  type         ContractType
  name         String               // e.g. "POST /api/login", "LoginResponse", "User"
  relationship ContractRelationship
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contractVersions ContractVersion[]

  @@map("task_contracts")
}

/// Work intent declared by an agent before modifying code.
/// Enables pre-code conflict detection.
model TaskWorkIntent {
  id          String   @id @default(cuid())
  taskId      String   @unique
  files       String[] // normalized file paths
  apis        String[]
  models      String[]
  contracts   String[]
  summary     String?
  declaredAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_work_intents")
}

// ─── Phase 4 Models ────────────────────────────────────────────────────────────

/// Phase 4: A connected Git repository for a project
model ProjectRepository {
  id                   String           @id @default(cuid())
  projectId            String
  provider             GitProvider      @default(GITHUB)
  owner                String           // GitHub org or user
  repository           String           // repo name
  defaultBranch        String           @default("main")
  externalRepositoryId String?          // provider's repo ID
  webhookSecret        String?          // stored server-side only
  status               RepositoryStatus @default(CONNECTED)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalEvents ExternalEvent[]
  actualChanges  TaskActualChange[]
  taskGitLinks   TaskGitLink[]

  @@unique([projectId, owner, repository])
  @@map("project_repositories")
}

/// Phase 4: Deduplicated external webhook events
model ExternalEvent {
  id              String              @id @default(cuid())
  provider        GitProvider         @default(GITHUB)
  externalEventId String              // provider's delivery ID
  eventType       String              // push, pull_request, etc.
  repositoryId    String
  payloadHash     String              // SHA256 of payload body
  receivedAt      DateTime            @default(now())
  processedAt     DateTime?
  status          ExternalEventStatus @default(RECEIVED)
  errorMessage    String?

  repository ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@map("external_events")
}

/// Phase 4: Actual file changes detected from Git for a task
model TaskActualChange {
  id           String           @id @default(cuid())
  taskId       String
  repositoryId String
  commitSha    String
  filePath     String
  changeType   ActualChangeType
  additions    Int              @default(0)
  deletions    Int              @default(0)
  metadata     Json?
  detectedAt   DateTime         @default(now())

  task       Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repository ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("task_actual_changes")
}

/// Phase 4: An indexed code entity (type, API, model, schema, etc.)
model CodeEntity {
  id           String         @id @default(cuid())
  projectId    String
  repositoryId String?
  type         CodeEntityType
  name         String         // e.g. "LoginResponse", "POST /api/login"
  filePath     String
  symbolName   String?        // e.g. fully-qualified name
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoingRelations  CodeRelationship[] @relation("SourceEntity")
  incomingRelations  CodeRelationship[] @relation("TargetEntity")
  contractChanges    ContractChange[]
  sourceRisks        CoordinationRisk[] @relation("RiskSourceEntity")
  contextUpdates     ContextUpdate[]
  tasks              TaskCodeEntity[]

  @@unique([projectId, filePath, name, type])
  @@map("code_entities")
}

model TaskCodeEntity {
  id         String   @id @default(cuid())
  projectId  String
  taskId     String
  entityId   String
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entity  CodeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([taskId, entityId])
  @@index([projectId, entityId])
  @@map("task_code_entities")
}

/// Phase 4: Relationship between two code entities
model CodeRelationship {
  id             String               @id @default(cuid())
  projectId      String
  sourceEntityId String
  targetEntityId String
  relationship   CodeRelationshipKind
  confidence     Confidence           @default(HIGH)
  source         RelationshipSource   @default(DETERMINISTIC)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceEntity CodeEntity @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity CodeEntity @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([sourceEntityId, targetEntityId, relationship])
  @@map("code_relationships")
}

/// Phase 4: A detected change to a contract entity
model ContractChange {
  id               String             @id @default(cuid())
  projectId        String
  taskId           String
  entityId         String
  previousRevision String?            // JSON snapshot of prior shape
  currentRevision  String?            // JSON snapshot of current shape
  changeKind       ContractChangeKind
  breaking         Boolean?           // null = undetermined
  confidence       Confidence         @default(HIGH)
  detectedAt       DateTime           @default(now())

  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entity CodeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("contract_changes")
}

/// Phase 4: Coordination risk between tasks
model CoordinationRisk {
  id             String                 @id @default(cuid())
  projectId      String
  sourceTaskId   String
  affectedTaskId String
  type           CoordinationRiskType
  severity       RiskSeverity           @default(MEDIUM)
  confidence     Confidence             @default(HIGH)
  title          String
  description    String
  sourceEntityId String?
  status         CoordinationRiskStatus @default(OPEN)
  detectedAt     DateTime               @default(now())
  resolvedAt     DateTime?

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTask   Task       @relation("SourceRisks", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  affectedTask Task       @relation("AffectedRisks", fields: [affectedTaskId], references: [id], onDelete: Cascade)
  sourceEntity CodeEntity? @relation("RiskSourceEntity", fields: [sourceEntityId], references: [id])

  @@map("coordination_risks")
}

/// Phase 4: Context update delivered to an affected task/agent
model ContextUpdate {
  id             String              @id @default(cuid())
  projectId      String
  sourceTaskId   String
  affectedTaskId String
  type           String              // e.g. CONTRACT_CHANGE, SCOPE_EXPANSION, BRANCH_DIVERGENCE
  title          String
  message        String
  entityId       String?
  riskId         String?
  status         ContextUpdateStatus @default(UNREAD)
  createdAt      DateTime            @default(now())
  acknowledgedAt DateTime?

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTask   Task       @relation("SourceUpdates", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  affectedTask Task       @relation("AffectedUpdates", fields: [affectedTaskId], references: [id], onDelete: Cascade)
  entity       CodeEntity? @relation(fields: [entityId], references: [id])

  @@map("context_updates")
}

// ─── Phase 5 Enums ────────────────────────────────────────────────────────────

// Phase 5: Derived readiness state for a task (calculated, not manually set)
enum TaskReadinessState {
  READY
  BLOCKED_BY_DEPENDENCY
  AT_RISK
  WAITING_FOR_REVIEW
  WAITING_FOR_CONTEXT
  INTERRUPTED
}

// Phase 5: Handoff lifecycle
enum HandoffStatus {
  PENDING
  DELIVERED
  ACKNOWLEDGED
  SUPERSEDED
}

// Phase 5: Context package lifecycle
enum ContextPackageStatus {
  CURRENT
  STALE
  SUPERSEDED
}

// Phase 5: Parallel safety classification
enum ParallelSafetyState {
  SAFE
  SAFE_WITH_WARNINGS
  UNSAFE
  UNKNOWN
}

// Phase 5: Recovery snapshot trigger
enum RecoveryTrigger {
  SESSION_STALE
  SESSION_ENDED_UNEXPECTEDLY
  USER_PAUSED
}

// ─── Phase 5 Models ───────────────────────────────────────────────────────────

/// Phase 5: Calculated readiness state for a task with structured reasons
model TaskReadinessEvaluation {
  id             String             @id @default(cuid())
  taskId         String
  state          TaskReadinessState
  reasons        Json               // string[]
  sourceRevision String?            // latest commit SHA at evaluation time
  evaluatedAt    DateTime           @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_readiness_evaluations")
}

/// Phase 5: Structured handoff from a completed/upstream task to a dependent task
model TaskHandoff {
  id                          String       @id @default(cuid())
  projectId                   String
  sourceTaskId                String
  targetTaskId                String
  sourceRevision              String?      // commit SHA of source task at time of handoff
  status                      HandoffStatus @default(PENDING)
  summary                     String       // human-readable summary
  payload                     Json         // structured handoff payload
  createdAt                   DateTime     @default(now())
  deliveredAt                 DateTime?
  acknowledgedAt              DateTime?
  acknowledgedByAgentSessionId String?
  supersededById              String?      // FK to newer TaskHandoff if superseded

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTask   Task     @relation("HandoffSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask   Task     @relation("HandoffTarget", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@map("task_handoffs")
}

/// Phase 5: Versioned context package delivered to an agent when beginning/resuming work
model TaskContextPackage {
  id                   String               @id @default(cuid())
  taskId               String
  contextVersion       Int                  @default(1)
  generatedAt          DateTime             @default(now())
  sourceProjectRevision String?
  status               ContextPackageStatus @default(CURRENT)
  content              Json                 // full structured context payload
  supersededAt         DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_context_packages")
}

/// Phase 5: Recovery snapshot created when a session goes stale or ends unexpectedly
model RecoverySnapshot {
  id                     String          @id @default(cuid())
  taskId                 String
  projectId              String
  previousAgentSessionId String?
  trigger                RecoveryTrigger
  lastKnownRevision      String?
  lastProgressMessage    String?
  activeWorkIntent       Json?           // copy of TaskWorkIntent
  actualScope            Json?           // list of actual file paths
  activeContracts        Json?           // relevant TaskContract records
  openRisks              Json?           // relevant CoordinationRisk summaries
  pendingContextUpdates  Json?           // unread ContextUpdate summaries
  pendingHandoffs        Json?           // pending TaskHandoff summaries
  createdAt              DateTime        @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("recovery_snapshots")
}

/// Phase 5: Parallel safety evaluation between two tasks
model ParallelSafetyEvaluation {
  id          String             @id @default(cuid())
  projectId   String
  taskAId     String
  taskBId     String
  state       ParallelSafetyState
  reasons     Json               // string[]
  warnings    Json               // string[]
  evaluatedAt DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskA   Task    @relation("ParallelSafetyA", fields: [taskAId], references: [id], onDelete: Cascade)
  taskB   Task    @relation("ParallelSafetyB", fields: [taskBId], references: [id], onDelete: Cascade)

  @@unique([taskAId, taskBId])
  @@map("parallel_safety_evaluations")
}

/// Phase 5: Registered capability profile for an agent integration
model AgentIntegrationCapability {
  id                    String   @id @default(cuid())
  projectId             String
  agentType             String   // e.g. "IBM_BOB", "CURSOR"
  supportsMcp           Boolean  @default(false)
  supportsHeartbeat     Boolean  @default(false)
  supportsContextUpdates Boolean @default(false)
  supportsHandoffs      Boolean  @default(false)
  supportsRecovery      Boolean  @default(false)
  supportsReviewTools   Boolean  @default(false)
  protocolVersion       String?  // e.g. "ACP/1.0"
  registeredAt          DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, agentType])
  @@map("agent_integration_capabilities")
}

// ─── Realignment Enums ────────────────────────────────────────────────────────

enum AgentLaunchStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
  FAILED
}

// ─── Realignment Models ───────────────────────────────────────────────────────

/// Auth session — token stored here, not in a cookie
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

/// Represents a request by a developer to launch an agent on a task.
/// The agent polls for PENDING requests and accepts them to begin working.
model AgentLaunchRequest {
  id               String             @id @default(cuid())
  projectId        String
  taskId           String
  userId           String
  agentType        String
  status           AgentLaunchStatus  @default(PENDING)
  contextPackageId String?
  createdAt        DateTime           @default(now())
  acceptedAt       DateTime?
  expiredAt        DateTime?
  agentSessionId   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("agent_launch_requests")
}
