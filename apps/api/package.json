    "fastify": "^4.28.1",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}


