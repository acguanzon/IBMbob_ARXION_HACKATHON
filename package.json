{
  "name": "arxion",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-agnostic collaboration layer for AI-assisted software development",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:bridge": "pnpm --filter @arxion/ide-bridge dev",
    "start:bridge": "pnpm --filter @arxion/ide-bridge start",
    "build:vscode-extension": "pnpm --filter arxion-vscode build",
    "package:vscode-extension": "pnpm --filter arxion-vscode package",
    "postinstall": "pnpm db:generate",
    "build": "pnpm --recursive --if-present build",
    "pretypecheck": "pnpm --filter @arxion/types build && pnpm --filter @arxion/database build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @arxion/database db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @arxion/database db:migrate",
    "db:migrate:prod": "pnpm --filter @arxion/database db:migrate:prod",
    "db:seed": "dotenv -e .env -- pnpm --filter @arxion/database db:seed",
    "db:studio": "pnpm --filter @arxion/database db:studio",
    "db:reset": "pnpm --filter @arxion/database db:reset"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
